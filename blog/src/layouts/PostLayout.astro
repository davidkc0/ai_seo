---
import BaseLayout from './BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  author: string;
  date: Date;
  updated?: Date;
  tags: string[];
  itemList?: string[];
  ogImage?: string;
}

const { title, description, author, date, updated, tags, itemList, ogImage } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const formattedUpdated = updated?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const readingTime = '8 min read'; // Could calculate from word count later
const canonicalUrl = Astro.url.href;
const isMarketPage = tags.some(tag => ['comparison', 'alternatives', 'tools'].includes(tag));
const schemaGraph: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalUrl,
    },
    "author": {
      "@type": "Person",
      "name": author,
    },
    "datePublished": date.toISOString(),
    "dateModified": (updated || date).toISOString(),
    "publisher": {
      "@type": "Organization",
      "name": "Illusion",
      "url": "https://www.illusion.ai",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.illusion.ai/OG.png",
      },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.illusion.ai/",
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": "https://www.illusion.ai/blog",
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": title,
        "item": canonicalUrl,
      },
    ],
  },
];

if (itemList?.length) {
  schemaGraph.push({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": title,
    "itemListElement": itemList.map((name, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": name,
    })),
  });
}
---

<BaseLayout title={`${title} | Illusion.ai`} description={description} ogImage={ogImage} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <article class="post-wrapper">
    <header class="post-header">
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map(tag => <span class="blog-tag">{tag}</span>)}
        </div>
      )}
      <h1>{title}</h1>
      <p class="post-description">{description}</p>
      <div class="post-meta">
        <img src="/blog/authors/david-c.jpg" alt={author} class="post-author-photo" />
        <div class="post-meta-text">
          <strong>{author}</strong>
          <span>{formattedDate} · {readingTime}</span>
        </div>
      </div>
      {formattedUpdated && (
        <p class="post-update-note">
          <strong>Last updated: {formattedUpdated}.</strong> {isMarketPage ? 'We review pricing, feature, and positioning notes as AI search tools change. Verify vendor pricing and plan details directly before buying.' : 'We refresh this guide as AI search behavior, website-audit patterns, and answer-engine guidance change.'}
        </p>
      )}
    </header>

    <div class="post-content">
      <slot />
    </div>

    <CTABlock />
  </article>
</BaseLayout>
